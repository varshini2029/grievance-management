# Copy this file to "config.properties" (same folder as pom.xml) and fill in your values.
# config.properties is git-ignored, so your password is never pushed to GitHub.
# Alternatively set environment variables DB_URL, DB_USER, DB_PASSWORD (they take priority).
db.url=jdbc:mysql://localhost:3306/grievance_db
db.user=root
db.password=YOUR_MYSQL_PASSWORD
